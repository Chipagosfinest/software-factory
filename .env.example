# GitHub App credentials
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# GitHub personal token (for signal harvester — free API rate limits)
GITHUB_TOKEN=

# LLM provider (OpenRouter for model-agnostic access)
OPENROUTER_API_KEY=

# Default model for agent reasoning
DEFAULT_MODEL=anthropic/claude-sonnet-4

# Redis for BullMQ job queue
REDIS_URL=redis://localhost:6379

# Server
PORT=3847

# Cost controls
MAX_COST_PER_RUN=2.00
AGENT_TIMEOUT_MS=300000
GLOBAL_DAILY_BUDGET_USD=20.00

# Optional: specific model overrides per agent
PR_REVIEW_MODEL=
CI_DEBUG_MODEL=
SECURITY_MODEL=
INCIDENT_MODEL=

# Supabase (ProductRank database)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Worker
WORKER_CONCURRENCY=3

# Database
DB_PATH=./software-factory.db

# Executor gate
EXECUTOR_GATE_PATH=./executor_gate.json

# ─── Orchestrator (Symphony-style) ──────────────────────────
# Set to "true" to enable the Linear polling + reconciliation loop
ORCHESTRATOR_ENABLED=false

# Linear API key (create at linear.app/settings/api)
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_LABEL=factory:auto

# Poll interval in milliseconds (default: 30s)
ORCHESTRATOR_POLL_MS=30000

# Workspace isolation
WORKSPACE_ROOT=./.workspaces

# Default repo for Linear issues that don't specify one
DEFAULT_REPO_OWNER=
DEFAULT_REPO_NAME=
